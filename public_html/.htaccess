AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
DirectoryIndex index.php
Options -Indexes

RewriteEngine On

# Force HTTPS after SSL certificate is enabled on the hosting.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Basic security headers. These work only after SSL is correctly enabled on the host.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  <FilesMatch "\.(?:css|js|png|jpg|jpeg|svg|webp|ico|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(service-worker\.js|manifest\.webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# Serve stylesheet with extra GARBALIA runtime fixes.
RewriteRule ^assets/style\.css$ assets/style-patched.php [L]

# Hide index.php and old ?page= links from the browser URL.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{QUERY_STRING} ^page=table&id=([0-9]+)$ [NC]
RewriteRule ^$ /table/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=([a-zA-Z0-9_-]+)$ [NC]
RewriteRule ^$ /%1? [R=301,L]

# Keep real files and folders accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Public QR menu routes.
RewriteRule ^menu/?$ menu.php [QSA,L]
RewriteRule ^menu-data/?$ menu-data.php [QSA,L]
RewriteRule ^menu-qr/?$ menu-qr.php [QSA,L]

# Clean POS routes.
RewriteRule ^statistics/?$ statistics-route.php [QSA,L]
RewriteRule ^history/?$ history-route.php [QSA,L]
RewriteRule ^products/?$ products.php [QSA,L]
RewriteRule ^receipts/?$ receipts.php [QSA,L]
RewriteRule ^print_final/?$ print_final.php [QSA,L]
RewriteRule ^print_order/?$ print_order.php [QSA,L]
RewriteRule ^table/([0-9]+)/?$ index.php?page=table&id=$1 [QSA,L]
RewriteRule ^(login|day|tables|reports|logout)/?$ index.php?page=$1 [QSA,L]
RewriteRule ^$ index.php?page=day [QSA,L]

<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>
